# ==============================================================================
# VoicePilot Environment Configuration Template
# DO NOT COMMIT REAL SECRETS OR KEYS TO VERSION CONTROL.
# Copy this file to .env and populate with your own credentials.
# ==============================================================================

# --- Google Gemini / AI Studio Configuration ---
# Your Gemini API key from Google AI Studio (https://aistudio.google.com/)
# NEVER commit a real key. This backend process is the only thing that should
# ever hold it — it is never sent to the browser/UI.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Live model for the real-time voice layer (Phase 4).
# Confirm the exact model id against the current Gemini Live API docs before a demo —
# preview model ids change. This is the only place the model id needs updating.
GEMINI_LIVE_MODEL=gemini-3.8-live

# API surface version used for the Live connection.
GEMINI_LIVE_API_VERSION=v1alpha

# Prebuilt Gemini Live voice for TTS output (e.g. Charon, Puck, Kore).
GEMINI_VOICE_NAME=Charon

# --- Optional GCP Configuration (if using Firestore or Vertex AI later) ---
GCP_PROJECT_ID=your_gcp_project_id_here
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# --- Agent Safety & Human-in-the-Loop Policies (future computer-use phase) ---
REQUIRE_CONFIRMATION_FOR_DESTRUCTIVE=true
SAFETY_GUARD_LEVEL=strict

# --- Voice Layer: Audio I/O ---
VOICE_INPUT_SAMPLE_RATE=16000
VOICE_OUTPUT_SAMPLE_RATE=24000
VOICE_CHANNELS=1
VOICE_CHUNK_SIZE=1024

# --- Voice Layer: Local voice-activity heuristic (observability only, never gates audio) ---
VOICE_VAD_RMS_THRESHOLD=500
VOICE_VAD_ONSET_CHUNKS=2
VOICE_VAD_HANGOVER_CHUNKS=10

# --- Voice Layer: Status WebSocket (UI reads connection/mic/speaking state here) ---
VOICE_WS_HOST=127.0.0.1
VOICE_WS_PORT=8765

# --- Voice Layer: Reconnect policy ---
VOICE_MAX_RECONNECT_ATTEMPTS=5
VOICE_RECONNECT_BASE_DELAY=1.0
VOICE_RECONNECT_MAX_DELAY=30.0

# --- Computer Use (MVP) ---
GEMINI_COMPUTER_USE_MODEL=gemini-3.8-flash
COMPUTER_USE_MAX_ACTIONS=10

# --- Wake Word (Phase 4.1) ---
# When enabled, Gemini Live is NOT connected and no mic audio leaves the
# machine until a wake word is detected locally. Default detector is a
# development stand-in (types a word into the terminal instead of real
# keyword spotting) -- see backend/wakeword/dev_detector.py.
WAKE_WORD_ENABLED=false
WAKE_WORDS=hey jarvis,computer
WAKE_WORD_IDLE_TIMEOUT_SECONDS=30

# --- Logging ---
LOG_LEVEL=INFO

# --- Execution & Verification (future computer-use phase) ---
MAX_ACTIONS_PER_PLAN=15
VERIFICATION_ENABLED=true
STEP_TIMEOUT_SECONDS=10
